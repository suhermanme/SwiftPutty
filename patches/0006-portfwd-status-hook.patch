+void portfwdmgr_report_status(PortFwdManager *mgr, PortFwdRecord *pfr,
+                              PortFwdStatusKind kind, const char *message)
+{
+    if (!pfr || !pfr->conf_key)
+        return;
+    PortFwdStatus status = {
+        .kind = kind, .key = pfr->conf_key, .value = pfr->conf_value,
+        .message = message,
+    };
+    lp_portfwd_status(log_get_policy(mgr->cl->logctx), &status);
 }
 
