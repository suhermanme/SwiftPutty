-         * those prompts written into lp->conf.
-         */
-        lp->formatted_cmd = format_telnet_command(
-            lp->addr, lp->port, lp->conf, NULL);
+            /*
+             * Now format the command a second time, with the results of
+             * those prompts written into lp->conf.
+             */
+            lp->formatted_cmd = format_telnet_command(
+                lp->addr, lp->port, lp->conf, NULL);
+        }
     }
 
